# Server
PORT=4021
NODE_ENV=development
# Public gateway origin (https) used in discovery + x402 resource.url challenges.
# Must be https on Railway — TLS terminates at the proxy; http:// breaks OKX listing checks.
PUBLIC_API_BASE_URL=https://founderforge-api-production.up.railway.app
# Optional — stamped into discovery JSON for marketplace agents
FOUNDERFORGE_ASP_AGENT_ID=9733
# When true, skip OKX payment middleware (local/dev/tests only).
# When false, real @okxweb3/x402 Express middleware is required — process exits if misconfigured.
PAYMENTS_BYPASS=true

# OKX Payment SDK (required when PAYMENTS_BYPASS=false)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Must be an EVM address (0x…), NOT an Agentic Wallet / ASP id (XKO…)
PAY_TO=0xYourWalletAddress
# eip155:196 = X Layer mainnet, eip155:1952 = testnet
NETWORK=eip155:1952
# Wait for on-chain settle before delivering paid responses (default true)
# OKX_SYNC_SETTLE=true

# Durable job store (required)
DATABASE_URL=postgres://founderforge:founderforge@localhost:5432/founderforge
REDIS_URL=redis://localhost:6379

# Shared object storage — ALL services use this one Supabase project (Feature 5)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=reports
# Signed download URL lifetime (default 7 days). Set 0 for public URLs when bucket is public.
REPORT_URL_TTL_SECONDS=604800

# Optional per-service folder prefixes inside SUPABASE_STORAGE_BUCKET (defaults shown)
# DEMO_SUPABASE_OBJECT_PREFIX=demos
# PROMO_SUPABASE_OBJECT_PREFIX=images
# REDDIT_DOC_SUPABASE_OBJECT_PREFIX=reddit
# OUTREACH_SUPABASE_OBJECT_PREFIX=outreach
# BRANDKIT_SUPABASE_OBJECT_PREFIX=brandkit

# Temporal (required for job execution)
# Local: temporal server start-dev  OR  docker compose in infra/docker
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=founderforge
# Temporal Cloud only (leave empty for self-hosted / local):
# TEMPORAL_API_KEY=
# TEMPORAL_TLS=true
# TEMPORAL_NAMESPACE=your-namespace.account-id
# TEMPORAL_ADDRESS=us-west-2.aws.api.temporal.io:7233

# Feature 5 — production stack
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-120b
GROQ_MODEL_BALANCED=openai/gpt-oss-120b
GROQ_MODEL_STRONG=openai/gpt-oss-120b
# Search providers (failover order: Serper → Brave → DuckDuckGo)
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
# Optional Jina Reader key (higher rate limits); free unauthenticated works too
# Get your Jina AI API key for free: https://jina.ai/?sui=apikey
JINA_API_KEY=
ALLOW_LIVE_FETCH=true

# Automated product demo — Firecrawl browser + Gemini plan/narration + Deepgram TTS
FIRECRAWL_API_KEY=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Promo video — Seedance (reuses FIRECRAWL_* / GEMINI_* and shared SUPABASE_* for images)
SEGMIND_API_KEY=
PROMO_SUPABASE_OBJECT_PREFIX=images

# Social listening — Tavily Reddit discovery → Groq drafts → PDF report (no auto-post)
# Reuses GROQ_API_KEY above; optional key pool GROQ_API_KEY_1..N
GROQ_API_KEY_1=
GROQ_MODEL=openai/gpt-oss-120b
# Ingest: tavily (default) — need statement → Tavily Reddit shortlist → Groq draft → PDF
# Alternatives: compound | reddapi
REDDIT_INGEST=tavily
GROQ_COMPOUND_MODEL=groq/compound-mini
COMPOUND_REDDIT_LIMIT=10
COMPOUND_REDDIT_PER_SUB=3
COMPOUND_SUB_GAP_MS=10000
# Tavily Research ONLY — Reddit thread discovery (no Search fallback)
TAVILY_API_KEY=
TAVILY_REDDIT_MODE=research
TAVILY_RESEARCH_MODEL=mini
TAVILY_REDDIT_LIMIT=10
TAVILY_POLL_MS=3000
TAVILY_RESEARCH_TIMEOUT_MS=180000
MAX_POSTS_PER_CYCLE=5
REDDIT_DOC_SUPABASE_OBJECT_PREFIX=reddit

# Outreach — website + revenue sheet → investor PDF (reuses GROQ_API_KEY / GROQ_API_KEY_1..N)
EXA_SEARCH_API_KEY=
# GROQ_COMPOUND_MODEL set above (social listening / outreach share it)
GROQ_SHEET_MODEL=openai/gpt-oss-120b
GROQ_MAX_CONCURRENCY=1
GROQ_MIN_INTERVAL_MS=2500
GROQ_TIMEOUT_MS=60000
GROQ_COMPOUND_TIMEOUT_MS=120000
# Optional Exa overrides
# EXA_SEARCH_TYPE=deep
# EXA_NUM_RESULTS=10
# EXA_PERSON_ENRICHMENT_LIMIT=0
OUTREACH_SUPABASE_OBJECT_PREFIX=outreach

# Brand kit — Vertex Gemini logos/assets + Google Fonts (zip to Supabase)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_LOCATION=global
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Optional pacing for Vertex rate limits
VERTEX_STEP_DELAY_MS=10000
VERTEX_MAX_ATTEMPTS=11
BRANDKIT_SUPABASE_OBJECT_PREFIX=brandkit
