# Server
PORT=4021
NODE_ENV=development
# When true, skip OKX payment middleware (local/dev only)
PAYMENTS_BYPASS=true

# OKX Payment SDK (required when PAYMENTS_BYPASS=false)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
PAY_TO=0x0000000000000000000000000000000000000000
# eip155:196 = X Layer mainnet, eip155:1952 = testnet
NETWORK=eip155:1952

# Durable job store (required)
DATABASE_URL=postgres://founderforge:founderforge@localhost:5432/founderforge
REDIS_URL=redis://localhost:6379

# Object storage for competitor-research PDFs (Feature 5)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=reports
# Signed download URL lifetime (default 7 days). Set 0 for public URLs when bucket is public.
REPORT_URL_TTL_SECONDS=604800

# Object storage for automated-product-demo videos (separate Supabase project)
DEMO_SUPABASE_URL=
DEMO_SUPABASE_SERVICE_ROLE_KEY=
DEMO_SUPABASE_STORAGE_BUCKET=demoforge
DEMO_SUPABASE_OBJECT_PREFIX=demos
# If > 0, return a signed URL instead of a public URL (seconds). 0 = public URL.
DEMO_SUPABASE_SIGNED_URL_EXPIRES_IN=0
# Alias for DEMO_SUPABASE_SIGNED_URL_EXPIRES_IN (optional)
DEMO_URL_TTL_SECONDS=

# Temporal (required for job execution)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=founderforge

# Feature 5 — production stack
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-120b
GROQ_MODEL_BALANCED=openai/gpt-oss-120b
GROQ_MODEL_STRONG=openai/gpt-oss-120b
# Search providers (failover order: Serper → Brave → DuckDuckGo)
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
# Optional Jina Reader key (higher rate limits); free unauthenticated works too
# Get your Jina AI API key for free: https://jina.ai/?sui=apikey
JINA_API_KEY=
ALLOW_LIVE_FETCH=true

# Automated product demo — Firecrawl browser + Gemini plan/narration + Deepgram TTS
FIRECRAWL_API_KEY=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Promo video — Seedance (reuses FIRECRAWL_* / GEMINI_* and DEMO_SUPABASE_* for images)
SEGMIND_API_KEY=
# Object prefix inside DEMO_SUPABASE_STORAGE_BUCKET for promo reference images (default images)
PROMO_SUPABASE_OBJECT_PREFIX=images

# Social listening — Reddit discover/score/draft/post (product_url → posted_urls)
# Reuses GROQ_API_KEY above; optional key pool GROQ_API_KEY_1..N
GROQ_API_KEY_1=
GROQ_MODEL=openai/gpt-oss-120b
# Ingest: compound (default) uses Groq Compound + Playwright; set reddapi to force ReddAPI listing fallback
REDDIT_INGEST=compound
COMPOUND_REDDIT_LIMIT=3
LLM_CANDIDATE_BUDGET=8
MAX_POSTS_PER_CYCLE=3
POST_IMMEDIATELY=true
# Reddit Chrome session (comments + token refresh) — Playwright only, no ReddAPI writes.
# On a VPS: bash scripts/run-xvfb.sh … so headed Chrome works without a monitor.
RAPIDAPI_KEY=
REDDAPI_PROXY=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_BROWSER_HEADED=true
REDDIT_CONTENT_HEADED=true
REDDIT_POST_HEADED=true
REDDIT_REFRESH_HEADED=true
#
# Reddit session via Supabase (any deploy — Cloud Run, VM, etc.)
# On start, pipeline pulls demoforge/redditcreds/{profile.tar.gz,cookies.json}
# into /tmp. Push once from a logged-in machine:
#   pnpm --filter @founderforge/social-listening-service reddit:push-session
# Set REDDIT_SESSION_REMOTE=false only for local debugging with a disk profile.
REDDIT_SESSION_REMOTE=true
REDDIT_SUPABASE_STORAGE_BUCKET=demoforge
REDDIT_SUPABASE_OBJECT_PREFIX=redditcreds
# Optional dedicated keys; otherwise DEMO_SUPABASE_URL + DEMO_SUPABASE_SERVICE_ROLE_KEY
# REDDIT_SUPABASE_URL=
# REDDIT_SUPABASE_SERVICE_ROLE_KEY=
# Optional local overrides (push source / remote=false). Not needed on deploy.
# REDDIT_PROFILE_DIR=
# REDDIT_SESSION_COOKIES_PATH=

# Outreach — website + revenue sheet → investor PDF (reuses GROQ_API_KEY / GROQ_API_KEY_1..N)
EXA_SEARCH_API_KEY=
GROQ_COMPOUND_MODEL=groq/compound
GROQ_SHEET_MODEL=openai/gpt-oss-120b
GROQ_MAX_CONCURRENCY=1
GROQ_MIN_INTERVAL_MS=2500
GROQ_TIMEOUT_MS=60000
GROQ_COMPOUND_TIMEOUT_MS=120000
# Optional Exa overrides
# EXA_SEARCH_TYPE=deep
# EXA_NUM_RESULTS=10
# EXA_PERSON_ENRICHMENT_LIMIT=0
# PDF upload (falls back to DEMO_SUPABASE_* when unset)
OUTREACH_SUPABASE_URL=
OUTREACH_SUPABASE_SERVICE_ROLE_KEY=
OUTREACH_SUPABASE_STORAGE_BUCKET=demoforge
OUTREACH_SUPABASE_OBJECT_PREFIX=outreach
OUTREACH_SUPABASE_SIGNED_URL_EXPIRES_IN=0

# Brand kit — Vertex Gemini logos/assets + Google Fonts (zip to Supabase)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_LOCATION=global
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Optional pacing for Vertex rate limits
VERTEX_STEP_DELAY_MS=10000
VERTEX_MAX_ATTEMPTS=11
BRANDKIT_SUPABASE_URL=
BRANDKIT_SUPABASE_SERVICE_ROLE_KEY=
BRANDKIT_SUPABASE_STORAGE_BUCKET=demoforge
BRANDKIT_SUPABASE_OBJECT_PREFIX=brandkit
BRANDKIT_SUPABASE_SIGNED_URL_EXPIRES_IN=0
