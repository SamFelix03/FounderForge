{
  "name": "@founderforge/competitor-research-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test src/**/*.test.ts",
    "live": "tsx src/scripts/live-run.ts",
    "batch": "tsx src/scripts/batch-run.ts",
    "postinstall": "playwright install chromium || true"
  },
  "dependencies": {
    "@founderforge/schemas": "workspace:*",
    "@founderforge/observability": "workspace:*",
    "@founderforge/connectors": "workspace:*",
    "@founderforge/llm-core": "workspace:*",
    "@supabase/supabase-js": "^2.50.0",
    "playwright": "^1.53.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
